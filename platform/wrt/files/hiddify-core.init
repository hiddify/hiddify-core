#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=10
PROG="/usr/bin/hiddify-core"

start_service() {
  config_load "hiddify-core"

  local enabled config_file working_directory log_stderr mode
  config_get_bool enabled "main" "enabled" "0"
  [ "$enabled" -eq "1" ] || return 0

  config_get config_file "main" "conffile" "/etc/hiddify-core/config.json"
  config_get working_directory "main" "workdir" "/usr/share/hiddify-core"
  config_get_bool log_stderr "main" "log_stderr" "1"
  # router: the whole network behind the router goes through the proxy (TCP, UDP and ICMP), and
  # connections from outside still reach the router and its port forwards. proxy: only the proxy
  # ports, as before (an install from before this option has none, and keeps that).
  config_get mode "main" "mode" "proxy"

  mkdir -p "$working_directory"

  procd_open_instance
  procd_set_param command "$PROG" run -c "$config_file" -D "$working_directory"
  [ "$mode" = "router" ] && procd_append_param command --router
  procd_set_param file "$config_file"
  procd_set_param stderr "$log_stderr"
  procd_set_param limits core="unlimited"
  procd_set_param limits nofile="1000000 1000000"
  procd_set_param respawn
  procd_close_instance
}

service_triggers() {
  procd_add_reload_trigger "hiddify-core"
}
